# Ignore all WordPress files by default.
*

# Keep Git able to traverse directories so nested allow-rules can match.
!*/

# Keep repository metadata tracked.
!.gitignore

# Keep sensitive/local WordPress configuration ignored.
wp-config.php
.htaccess

# Track only the custom apphosting plugin.
!wp-content/
!wp-content/plugins/
!wp-content/plugins/apphosting/
!wp-content/plugins/apphosting/**

# Track only the custom app-hosting theme.
!wp-content/themes/
!wp-content/themes/app-hosting/
!wp-content/themes/app-hosting/**

